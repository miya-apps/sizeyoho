rules_version = '2';

// サイズ予報：Pro版オンラインバックアップのアクセス制御。
// 各ユーザーは自分の uid 配下（メタ情報＋バックアップのチャンク）だけ
// 読み書きできる。他人のデータには一切アクセスできない。
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      function isOwner() {
        return request.auth != null && request.auth.uid == uid;
      }

      function deletionStarted() {
        return 'deleting' in resource.data && resource.data.deleting == true;
      }

      allow read, create: if isOwner();
      allow delete: if isOwner() && !deletionStarted();
      // `deleting: true`への最初の更新は許可し、それ以後は遅延した別端末が
      // metadataを上書きして削除を取り消せないようにする。
      allow update: if isOwner() && !deletionStarted();

      match /backup/{chunk} {
        function parentDeletionStarted() {
          let parentPath = /databases/$(database)/documents/users/$(uid);
          return exists(parentPath) &&
              'deleting' in get(parentPath).data &&
              get(parentPath).data.deleting == true;
        }

        allow read, delete: if isOwner();
        // 既存Androidの初回backupは親documentより先にchunkを作るため、
        // 親がまだ無い場合は維持する。削除markerがあれば新規writeだけ拒否する。
        allow create, update: if isOwner() && !parentDeletionStarted();
      }
    }
  }
}
