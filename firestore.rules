rules_version = '2';

// サイズ予報：Pro版オンラインバックアップのアクセス制御。
// 各ユーザーは自分の uid 配下（メタ情報＋バックアップのチャンク）だけ
// 読み書きできる。他人のデータには一切アクセスできない。
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      match /backup/{chunk} {
        allow read, write: if request.auth != null && request.auth.uid == uid;
      }
    }
  }
}
